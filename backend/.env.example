# ============================================================================
#  Copy this file to `.env` and fill in real values. `.env` is GITIGNORED.
#  NEVER commit real keys. NEVER put keys in URLs or logs.
# ============================================================================

# ---- App ----
APP_ENV=local
LOG_LEVEL=INFO

# ---- Database ----
# SQLite (local dev default). For Postgres use e.g.:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/trading
DATABASE_URL=sqlite:///./trading.sqlite3

# ---- Global kill switch ----
# When true, the backend refuses to submit ANY new order regardless of mode.
# This is the env-level backstop for the UI kill-switch button.
KILL_SWITCH=false

# ---- Trading environment ----
# "paper" is the only safe default. Switching to "live" also requires the
# Settings confirmation flow inside the app — the env var alone is not enough.
BROKER_ENV=paper

# ---- LLM provider: "anthropic" (Claude) or "gemini" (Google). Override in the UI. ----
LLM_PROVIDER=anthropic

# ---- Anthropic (agents) ----
ANTHROPIC_API_KEY=
# Model name is a config value so it can be upgraded without code changes.
ANTHROPIC_MODEL=claude-opus-4-8

# ---- Google Gemini (alternative agent provider) ----
GEMINI_API_KEY=
# Recommended: gemini-2.5-flash (fast/cheap) or gemini-2.5-pro (max reasoning).
GEMINI_MODEL=gemini-2.5-flash

# ---- Alpaca (paper) — added/used in Milestone 2 ----
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# ---- OANDA (forex/metals) — Milestone 7 ----
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice

# ---- ccxt (crypto) — Milestone 7 ----
CCXT_EXCHANGE=binance
CCXT_API_KEY=
CCXT_API_SECRET=

# ---- MetaTrader 5 (Exness and other MT5 brokers) ----
# Requires the MT5 terminal installed + logged in, with "Algo Trading" enabled. Windows only.
# Use a DEMO account first. Server is shown in the MT5 login dialog (e.g. Exness-MT5Trial).
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Optional: full path to terminal64.exe if MT5 isn't auto-detected.
MT5_PATH=

# ---- Live-mode confirmation phrase ----
# The exact phrase the user must type in Settings to enable Mode C (live auto-exec).
LIVE_CONFIRM_PHRASE=I understand this trades real money
